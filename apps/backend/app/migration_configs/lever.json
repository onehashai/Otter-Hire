{
  "id": "lever",
  "name": "Lever",
  "enabled": true,
  "auth": {"type": "basic", "header_name": "Authorization"},
  "base_url": "https://api.lever.co",
  "endpoints": {
    "jobs": {"path": "/v1/postings", "method": "GET", "response_root_key": "data", "params": {"limit": 100, "include": "content"}, "pagination": {"style": "cursor", "cursor_request_param": "offset", "cursor_response_path": "next", "page_size": 100, "since_param_name": "updated_at_start", "since_format": "unix_ms"}},
    "stages": {"path": "/v1/stages", "method": "GET", "response_root_key": "data", "params": {"limit": 100}},
    "candidates": {"path": "/v1/opportunities", "method": "GET", "response_root_key": "data", "params": {"limit": 100, "expand": "applications"}, "pagination": {"style": "cursor", "cursor_request_param": "offset", "cursor_response_path": "next", "page_size": 100, "since_param_name": "updated_at_start", "since_format": "unix_ms"}},
    "resumes": {"path": "/v1/opportunities/{external_candidate_id}/resumes", "method": "GET", "response_root_key": "data", "pagination": {"style": "none"}},
    "interviews": {"path": "/v1/opportunities/{external_candidate_id}/interviews", "method": "GET", "response_root_key": "data", "pagination": {"style": "none"}},
    "notes": {"path": "/v1/opportunities/{external_candidate_id}/notes", "method": "GET", "response_root_key": "data", "pagination": {"style": "none"}}
  },
  "pagination": {"style": "cursor", "cursor_request_param": "offset", "cursor_response_path": "next", "page_size": 100},
  "rate_limits": {"requests_per_second": 2, "max_retries": 5, "backoff_seconds": 1},
  "mappings": {
    "job": {"external_job_id": "id", "title": "text", "description": "content.description"},
    "stage": {"external_stage_id": "id", "name": "text", "position": "position"},
    "candidate": {"external_candidate_id": "id", "first_name": "first_name", "last_name": "last_name", "email": "emails.0", "phone": "phones.0.value", "skills": "tags"},
    "application": {"external_application_id": "id", "external_candidate_id": "candidate_id", "external_job_id": "posting", "external_stage_id": "stage_id", "status": "status"},
    "resume": {"external_document_id": "id", "external_candidate_id": "candidate_id", "source_url": "file.downloadUrl", "filename": "file.name"},
    "interview": {"external_interview_id": "id", "external_candidate_id": "candidate_id", "external_job_id": "job_id", "scheduled_at": "date", "interviewer_name": "interviewers.0.name"},
    "note": {"external_note_id": "id", "external_candidate_id": "candidate_id", "content": "content", "author_name": "author_name"}
  }
}
