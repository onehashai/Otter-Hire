DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ats_db
IS_PRODUCTION=false
CORS_ORIGINS=http://app.localhost.com:3000,http://jobs.localhost.com:3000,http://api.localhost.com:8000
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Frontend URL
FRONTEND_BASE_URL=http://app.localhost.com:3000

# Cookie domain (empty for localhost, domain.com for production)
COOKIE_DOMAIN=

APP_DOMAIN=localhost.com
APP_SUBDOMAIN=app
JOBS_SUBDOMAIN=jobs

# Production example:
# FRONTEND_BASE_URL=https://app.onehash.ai
# COOKIE_DOMAIN=.onehash.ai
# CORS_ORIGINS=https://app.onehash.ai

# Staging example:
# FRONTEND_BASE_URL=https://app.staging.onehash.ai
# COOKIE_DOMAIN=.staging.onehash.ai
# CORS_ORIGINS=https://app.staging.onehash.ai

# Mailtrap (dev only - leave commented to print verification URLs to console)
# MAILTRAP_HOST=sandbox.smtp.mailtrap.io
# MAILTRAP_PORT=2525
# MAILTRAP_USERNAME=your_username
# MAILTRAP_PASSWORD=your_password
# MAILTRAP_FROM_EMAIL=noreply@onehash.ai

# ZeptoMail (prod only - required when IS_PRODUCTION=true)
# ZEPTOMAIL_API_KEY=your_api_key
# ZEPTOMAIL_FROM_EMAIL=noreply@onehash.ai
# ZEPTOMAIL_FROM_NAME=OneHash ATS

# Storage
LOCAL_STORAGE_ROOT=storage/local
MAX_UPLOAD_BYTES=1048576

# S3 (if all values below are present, storage uses S3; otherwise local storage is used)
# AWS_S3_BUCKET=your-bucket
# AWS_S3_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# S3_ROOT_PREFIX=ats-staging
# Root prefix is otherwise automatic:
# - IS_PRODUCTION=false -> ats-staging/
# - IS_PRODUCTION=true  -> ats-production/

# Inbound careers inbox webhook
# INBOUND_WEBHOOK_SECRET=replace-with-strong-shared-secret
# INBOUND_EMAIL_DOMAIN=inbound.smartats.in
INBOUND_MAX_ATTACHMENT_BYTES=10485760

# SES raw bridge worker (S3 raw objects -> /public/inbound/email)
# SES_RAW_BRIDGE_ENABLED=true
# SES_RAW_BRIDGE_BUCKET=onehash-ats-test
# SES_RAW_BRIDGE_PREFIX=ats-staging/ses-inbound/raw/
# SES_RAW_BRIDGE_POLL_SECONDS=300
# SES_RAW_BRIDGE_MAX_KEYS=100

# Retention cleanup for ignored inbound emails
# INBOUND_IGNORED_CLEANUP_ENABLED=true
# INBOUND_IGNORED_RETENTION_DAYS=30
# INBOUND_IGNORED_CLEANUP_INTERVAL_SECONDS=3600
# INBOUND_RESUME_MIN_CONFIDENCE=6

# REDIS_URL=redis://redis:6379/0
# TEMPORAL_SERVER_URL=temporal:7233
# TEMPORAL_NAMESPACE=default
# INBOUND_EVENTS_CHANNEL=ats:inbound:events
# Worker calls this URL to POST parsed inbound email to the backend. Use the same
# host and path the frontend uses for the API so one SSL cert covers it.
# - Local: http://backend:8000 (docker) or http://localhost:8000
# - Production: https://app.smartats.in/api (API under app host; cert for *.smartats.in)
#   Do NOT use https://api.smartats.in unless that host has an ACM cert on its ALB.
# INBOUND_INTERNAL_API_BASE_URL=http://localhost:8000
# ── SNS (optional; inbound is handled by SES raw bridge polling S3) ───────
# Optional allowlist — leave empty to allow any topic (not recommended for production).
# INBOUND_SNS_TOPIC_ARNS=arn:aws:sns:ap-south-1:123456789012:ses-inbound-topic
# Auto-confirm SNS subscription callbacks (default: true)
# INBOUND_SNS_AUTO_CONFIRM=true
# Verify RSA signature on every SNS notification — strongly recommended in production.
# INBOUND_SNS_VERIFY_SIGNATURE=true

# Phase-0 feature flags for integrations refactor (keep false during baseline freeze)
# FEATURE_INTEGRATIONS_APP_STORE_UI=false
# FEATURE_EMAIL_INTEGRATION_MODULE=false
# FEATURE_LEGACY_ORG_INBOX_ROUTE_REDIRECT=false


# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# SMTP outbound credential encryption key (Fernet, required to use SMTP outbound integration)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SMTP_ENCRYPTION_KEY=your-fernet-key-here

# ── Outbound email delivery & open tracking ────────────────────────────────

# SES Configuration Set (optional) — when set, adds X-SES-Configuration-Set header
# to every outbound email so SES publishes Delivery/Open/Bounce events via SNS.
# SES_CONFIGURATION_SET=ats-outbound-events

# SNS topic ARN(s) that SES will POST delivery/open events to (comma-separated).
# Subscribe the endpoint  POST https://<api-host>/webhooks/ses-events  to these topics.
# SES_EVENTS_SNS_TOPIC_ARNS=arn:aws:sns:ap-south-1:123456789012:ses-outbound-events

# ---------------------------------------------------------------------------
# SQLAdmin (local development only — not used when IS_PRODUCTION=true)
# Available at http://localhost:8000/admin
# ---------------------------------------------------------------------------
SQLADMIN_USERNAME=admin
SQLADMIN_PASSWORD=admin
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SQLADMIN_SECRET_KEY=sqladmin-dev-secret-change-me
