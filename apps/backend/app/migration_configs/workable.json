{
  "id": "workable",
  "name": "Workable",
  "enabled": true,
  "auth": {"type": "bearer", "header_name": "Authorization"},
  "base_url": "http://localhost:8996",
  "endpoints": {"jobs": {"path": "/spi/v3/jobs", "method": "GET", "response_root_key": "jobs"}, "stages": {"path": "/spi/v3/stages", "method": "GET", "response_root_key": "stages"}, "candidates": {"path": "/spi/v3/candidates", "method": "GET", "response_root_key": "candidates"}, "applications": {"path": "/spi/v3/applications", "method": "GET", "response_root_key": "applications"}, "resumes": {"path": "/spi/v3/resumes", "method": "GET", "response_root_key": "resumes"}, "interviews": {"path": "/spi/v3/interviews", "method": "GET", "response_root_key": "interviews"}, "notes": {"path": "/spi/v3/notes", "method": "GET", "response_root_key": "notes"}},
  "pagination": {"style": "cursor", "cursor_request_param": "next", "cursor_response_path": "paging.next", "page_size": 100},
  "rate_limits": {"requests_per_second": 2, "max_retries": 5, "backoff_seconds": 1},
  "mappings": {"job": {"external_job_id": "id", "title": "title", "description": "description"}, "stage": {"external_stage_id": "id", "external_job_id": "job_id", "name": "name", "position": "position"}, "candidate": {"external_candidate_id": "id", "first_name": "firstname", "last_name": "lastname", "email": "email", "phone": "phone", "skills": "skills", "resume_text": "resume_text"}, "application": {"external_application_id": "id", "external_candidate_id": "candidate_id", "external_job_id": "job_id", "external_stage_id": "stage_id", "status": "status"}, "resume": {"external_document_id": "id", "external_candidate_id": "candidate_id", "source_url": "url", "filename": "filename", "mime_type": "content_type"}, "interview": {"external_interview_id": "id", "external_candidate_id": "candidate_id", "external_job_id": "job_id", "scheduled_at": "scheduled_at", "interviewer_name": "interviewer_name"}, "note": {"external_note_id": "id", "external_candidate_id": "candidate_id", "content": "content", "author_name": "author_name"}}
}
