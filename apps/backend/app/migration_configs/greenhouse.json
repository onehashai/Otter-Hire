{
  "id": "greenhouse",
  "name": "Greenhouse",
  "enabled": true,
  "auth": {"type": "oauth2", "header_name": "Authorization"},
  "base_url": "https://harvest.greenhouse.io",
  "endpoints": {
    "jobs": {"path": "/v3/jobs", "method": "GET", "params": {"per_page": 500}},
    "stages": {"path": "/v3/job_interview_stages", "method": "GET", "params": {"per_page": 500, "active": true}},
    "candidates": {"path": "/v3/candidates", "method": "GET", "params": {"per_page": 500}},
    "applications": {"path": "/v3/applications", "method": "GET", "params": {"per_page": 500}},
    "application_stages": {"path": "/v3/application_stages", "method": "GET", "params": {"per_page": 500, "current": true}},
    "resumes": {"path": "/v3/attachments", "method": "GET", "params": {"per_page": 500, "type": "resume"}},
    "interviews": {"path": "/v3/interviews", "method": "GET", "params": {"per_page": 500}},
    "notes": {"path": "/v3/notes", "method": "GET", "params": {"per_page": 500}}
  },
  "pagination": {"style": "link_header", "page_size": 500, "since_param_name": "updated_at[gte]"},
  "rate_limits": {"requests_per_second": 2, "max_retries": 5, "backoff_seconds": 1},
  "mappings": {
    "job": {"external_job_id": "id", "title": "name", "description": "notes"},
    "stage": {"external_stage_id": "id", "external_job_id": "job_id", "name": "name", "position": "sort_order"},
    "candidate": {"external_candidate_id": "id", "first_name": "first_name", "last_name": "last_name", "email": "email_addresses.0.value", "phone": "phone_numbers.0.value", "skills": "tags"},
    "application": {"external_application_id": "id", "external_candidate_id": "candidate_id", "external_job_id": "job_id", "external_stage_id": "job_interview_stage_id", "status": "status"},
    "resume": {"external_document_id": "id", "external_candidate_id": "candidate_id", "source_url": "url", "filename": "filename", "mime_type": "content_type"},
    "interview": {"external_interview_id": "id", "external_candidate_id": "candidate_id", "external_job_id": "job_id", "scheduled_at": "starts_at", "interviewer_name": "interviewers.0.name"},
    "note": {"external_note_id": "id", "external_candidate_id": "candidate_id", "content": "body", "author_name": "user_name"}
  }
}
