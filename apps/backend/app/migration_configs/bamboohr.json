{
  "id": "bamboohr",
  "name": "BambooHR",
  "enabled": true,
  "auth": {"type": "basic", "header_name": "Authorization"},
  "base_url": "https://company.bamboohr.com",
  "endpoints": {
    "jobs": {"path": "/api/v1/applicant_tracking/jobs", "method": "GET", "pagination": {"style": "none"}},
    "stages": {"path": "/api/v1/applicant_tracking/statuses", "method": "GET", "pagination": {"style": "none"}},
    "candidates": {"path": "/api/v1/applicant_tracking/applications", "method": "GET", "pagination": {"style": "page", "page_param": "page", "page_size_param": null, "since_param_name": "newSince", "since_format": "%Y-%m-%d %H:%M:%S"}},
    "applications": {"path": "/api/v1/applicant_tracking/applications", "method": "GET", "pagination": {"style": "page", "page_param": "page", "page_size_param": null, "since_param_name": "newSince", "since_format": "%Y-%m-%d %H:%M:%S"}},
    "application_details": {"path": "/api/v1/applicant_tracking/applications/{external_application_id}", "method": "GET", "pagination": {"style": "none"}}
  },
  "pagination": {"style": "none"},
  "rate_limits": {"requests_per_second": 2, "max_retries": 5, "backoff_seconds": 1},
  "mappings": {
    "job": {"external_job_id": "id", "title": "title", "description": "description", "category": "department"},
    "stage": {"external_stage_id": "id", "name": "name", "position": "position"},
    "candidate": {"external_candidate_id": "applicant.id", "first_name": "applicant.firstName", "last_name": "applicant.lastName", "email": "applicant.email", "phone": "applicant.phone"},
    "application": {"external_application_id": "id", "external_candidate_id": "applicant.id", "external_job_id": "job.id", "external_stage_id": "status.id", "status": "status.name"},
    "resume": {"external_document_id": "id", "external_candidate_id": "candidate_id", "source_url": "url", "filename": "filename", "mime_type": "content_type"}
  }
}
