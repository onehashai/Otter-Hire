{
  "id": "smartrecruiters",
  "name": "SmartRecruiters",
  "enabled": true,
  "auth": {"type": "api_key", "header_name": "X-SmartToken"},
  "base_url": "https://api.smartrecruiters.com",
  "endpoints": {
    "jobs": {"path": "/jobs", "method": "GET", "response_root_key": "content", "params": {"limit": 100, "sort": "job_id"}},
    "candidates": {"path": "/candidates", "method": "GET", "response_root_key": "content", "params": {"limit": 100}, "pagination": {"style": "cursor", "cursor_request_param": "pageId", "cursor_response_path": "nextPageId", "page_size": 100, "since_param_name": "updatedAfter"}},
    "candidate_details": {"path": "/candidates/{external_candidate_id}", "method": "GET", "pagination": {"style": "none"}},
    "resumes": {"path": "/candidates/{external_candidate_id}/attachments", "method": "GET", "response_root_key": "content", "pagination": {"style": "none"}}
  },
  "pagination": {"style": "cursor", "cursor_request_param": "pageId", "cursor_response_path": "nextPageId", "page_size": 100},
  "rate_limits": {"requests_per_second": 2, "max_retries": 5, "backoff_seconds": 1},
  "mappings": {
    "job": {"external_job_id": "id", "title": "name", "description": "description", "category": "department.label", "city": "location.city", "country": "location.country", "workplace_type": "location.remote"},
    "stage": {"external_stage_id": "id", "external_job_id": "jobId", "name": "name", "position": "position"},
    "candidate": {"external_candidate_id": "id", "first_name": "firstName", "last_name": "lastName", "email": "email", "phone": "phoneNumber", "skills": "skills"},
    "application": {"external_application_id": "id", "external_candidate_id": "candidateId", "external_job_id": "jobId", "external_stage_id": "status.id", "status": "status.name"},
    "resume": {"external_document_id": "id", "external_candidate_id": "candidate_id", "source_url": "url", "filename": "name", "mime_type": "contentType"}
  }
}
