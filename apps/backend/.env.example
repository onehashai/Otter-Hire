# Copy to `.env`. Only variables that application code reads via `settings` (see `app/core/config.py`).
# Omitted: APP_DOMAIN / APP_SUBDOMAIN / JOBS_SUBDOMAIN — defined on Settings but not referenced in code yet.
#
# =============================================================================
# Core
# =============================================================================
# Usage: Async SQLAlchemy database URL.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ats_db
# Usage: Production mode (HTTPS cookies, SQLAdmin off, S3 prefix, etc.).
IS_PRODUCTION=false
# Usage: Root log level for the app and uvicorn.
LOG_LEVEL=INFO
# Usage: Product name in API metadata and emails.
PLATFORM_NAME=Otter
# Usage: Support contact in email footers.
SUPPORT_EMAIL=support@otter.bz

# =============================================================================
# JWT & session tokens
# =============================================================================
# Usage: Secret for signing JWT access and refresh tokens.
JWT_SECRET_KEY=change-me-in-production
# Usage: JWT algorithm.
JWT_ALGORITHM=HS256
# Usage: Access token lifetime (minutes).
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Usage: Refresh token lifetime (days).
REFRESH_TOKEN_EXPIRE_DAYS=30
# Usage: Email verification token window (hours).
VERIFICATION_TOKEN_EXPIRE_HOURS=24
# Usage: Team invite token lifetime (days).
INVITE_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# CORS
# =============================================================================
# Usage: Allowed browser origins (comma-separated or JSON array).
CORS_ORIGINS=http://app.localhost.com:3000,http://jobs.localhost.com:3000

# =============================================================================
# Public URLs & cookies
# =============================================================================
# Usage: App base URL for links, emails, OAuth error redirects.
FRONTEND_BASE_URL=http://app.localhost.com:3000
# Usage: Optional full URL to a logo image for transactional emails.
EMAIL_LOGO_URL=
# Usage: Public API base URL (OAuth callbacks, LinkedIn redirects, etc.).
API_BASE_URL=http://api.localhost.com:8000
# Usage: Cookie Domain scope for auth cookies across subdomains.
COOKIE_DOMAIN=.localhost.com

# =============================================================================
# Google OAuth
# =============================================================================
# Usage: Google OAuth client ID and secret (`google_oauth_enabled` when both set).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =============================================================================
# LinkedIn OAuth & features
# =============================================================================
# Usage: LinkedIn app credentials and webhook verification (`linkedin_oauth_enabled` when id+secret set).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_WEBHOOK_SECRET=
# Usage: Gate posting jobs to LinkedIn (`jobs.py`).
FEATURE_LINKEDIN_DISTRIBUTION=true
# Usage: Gate applicant ingestion from LinkedIn (`linkedin.py`).
FEATURE_LINKEDIN_APPLICANT_INGESTION=true

# =============================================================================
# Outbound email — ZeptoMail (unchanged; wins over SES when API key + from are set)
# =============================================================================
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_FROM_EMAIL=
ZEPTOMAIL_FROM_NAME=

# =============================================================================
# Outbound email — SES only (used when ZeptoMail is not configured)
# =============================================================================
# Transactional: verification, invites, platform email (default effective From: noreply@smartats.in if unset).
SES_TRANSACTIONAL_FROM_EMAIL=noreply@smartats.in
SES_TRANSACTIONAL_FROM_NAME=
# Legacy optional — only if SES_TRANSACTIONAL_FROM_EMAIL is empty (migration from older single-sender setups).
SES_FROM_EMAIL=
SES_FROM_NAME=
# Conversational SES From is reply+<id>@<SES_MAIL_DOMAIN> (see below).

# =============================================================================
# SES outbound events
# =============================================================================
# Usage: SES configuration set on outbound mail for event publishing.
SES_CONFIGURATION_SET=
# Usage: Comma-separated SNS topic ARNs allowed to POST SES events to `/webhooks/ses-events`.
SES_EVENTS_SNS_TOPIC_ARNS=

# =============================================================================
# File storage
# =============================================================================
# Usage: Local filesystem root when S3 is not configured.
LOCAL_STORAGE_ROOT=storage/local
# Usage: Max size for POST `.../candidates/{id}/documents/upload` (PDF only, `read_upload_with_size_check`).
MAX_UPLOAD_BYTES=1048576
# Usage: Max size for user profile and organization logo uploads (`/me/avatar`).
AVATAR_MAX_UPLOAD_BYTES=1048576
# Usage: Max size for public job application multipart file upload (`/orgs/.../apply/upload`).
PUBLIC_JOB_APPLY_MAX_UPLOAD_BYTES=1048576
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Usage: Optional S3 key prefix override (`ats-staging` / `ats-production` if empty).
S3_ROOT_PREFIX=

# =============================================================================
# Mail routing domain (inbound delivery + conversational reply+ outbound)
# =============================================================================
# Hostname only (no @): same domain for SES inbound receipt and for reply+...@domain on conversational mail.
SES_MAIL_DOMAIN=

# =============================================================================
# Inbound email
# =============================================================================
# Usage: Default inbound webhook secret when org config has no `secret_hash`.
INBOUND_WEBHOOK_SECRET=
# Usage: Max attachment bytes for inbound email and public apply JSON attachments (base64) where this setting is enforced.
INBOUND_MAX_ATTACHMENT_BYTES=5242880
# Usage: Minimum resume-parser confidence to accept an inbound attachment as a resume.
INBOUND_RESUME_MIN_CONFIDENCE=6

# =============================================================================
# SES raw bridge worker
# =============================================================================
# Usage: When true, starts S3 polling for raw SES inbound (`main.py`).
SES_RAW_BRIDGE_ENABLED=false
SES_RAW_BRIDGE_BUCKET=
SES_RAW_BRIDGE_PREFIX=
SES_RAW_BRIDGE_POLL_SECONDS=30
SES_RAW_BRIDGE_MAX_KEYS=20
# Usage: Skip S3 objects newer than this many seconds (avoid SNS/S3 race).
INBOUND_SNS_FALLBACK_GRACE_SECONDS=120
# Usage: Delete old ignored inbound rows and raw S3 objects when true.
INBOUND_IGNORED_CLEANUP_ENABLED=true
INBOUND_IGNORED_RETENTION_DAYS=30
INBOUND_IGNORED_CLEANUP_INTERVAL_SECONDS=3600

# =============================================================================
# Redis & Temporal
# =============================================================================
REDIS_URL=redis://redis:6379/0
TEMPORAL_SERVER_URL=temporal:7233
TEMPORAL_NAMESPACE=default
# Usage: Redis pub/sub channel for inbound events (SSE / `public.py`).
INBOUND_EVENTS_CHANNEL=ats:inbound:events

# =============================================================================
# Worker → API
# =============================================================================
# Usage: Base URL for worker POSTs to `/v1/internal/inbound/email` (`ses_bridge.py`).
BACKEND_URL=http://localhost:8000

# =============================================================================
# Inbound SNS (HTTP webhook path)
# =============================================================================
# Usage: Allowed SNS topic ARNs for inbound notifications (empty allows any — avoid in prod).
INBOUND_SNS_TOPIC_ARNS=
# Usage: Verify SNS signature on inbound POSTs (`public.py`).
INBOUND_SNS_VERIFY_SIGNATURE=false

# =============================================================================
# OpenAI
# =============================================================================
# Usage: Resume parsing and job-description AI when set (`resume`, `jobs`, `job_description_ai`).
OPENAI_API_KEY=
# Usage: Max output tokens for resume LLM extraction (default 6000).
RESUME_PARSE_MAX_TOKENS=6000
# Usage: Redis cache TTL for parsed resume results in days (default 30).
RESUME_PARSE_CACHE_TTL_DAYS=30

# =============================================================================
# SQLAdmin (disabled when IS_PRODUCTION=true)
# =============================================================================
SQLADMIN_USERNAME=admin
SQLADMIN_PASSWORD=admin
SQLADMIN_SECRET_KEY=sqladmin-dev-secret-change-me

# =============================================================================
# Sentry
# =============================================================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0

# ==============================================================================
# Encryption key for credentials
# to genrate
# pip install cryptography && python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ==============================================================================
ENCRYPTION_KEY=