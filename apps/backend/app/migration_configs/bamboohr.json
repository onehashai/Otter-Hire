{
  "id": "bamboohr",
  "name": "BambooHR",
  "enabled": true,
  "auth": {"type": "basic", "header_name": "Authorization"},
  "base_url": "http://localhost:8995",
  "endpoints": {"jobs": {"path": "/api/v1/jobs", "method": "GET", "response_root_key": "jobs"}, "stages": {"path": "/api/v1/stages", "method": "GET", "response_root_key": "stages"}, "candidates": {"path": "/api/v1/applicants", "method": "GET", "response_root_key": "applications"}, "applications": {"path": "/api/v1/applications", "method": "GET", "response_root_key": "applications"}, "resumes": {"path": "/api/v1/resumes", "method": "GET", "response_root_key": "resumes"}, "interviews": {"path": "/api/v1/interviews", "method": "GET", "response_root_key": "interviews"}, "notes": {"path": "/api/v1/notes", "method": "GET", "response_root_key": "notes"}},
  "pagination": {"style": "page", "page_param": "page", "page_size_param": "pageSize", "page_size": 100},
  "rate_limits": {"requests_per_second": 2, "max_retries": 5, "backoff_seconds": 1},
  "mappings": {"job": {"external_job_id": "id", "title": "name", "description": "description"}, "stage": {"external_stage_id": "id", "external_job_id": "jobId", "name": "name", "position": "position"}, "candidate": {"external_candidate_id": "id", "first_name": "firstName", "last_name": "lastName", "email": "email", "phone": "phone", "skills": "skills", "resume_text": "resumeText"}, "application": {"external_application_id": "id", "external_candidate_id": "candidateId", "external_job_id": "jobId", "external_stage_id": "stageId", "status": "status"}, "resume": {"external_document_id": "id", "external_candidate_id": "candidateId", "source_url": "url", "filename": "filename", "mime_type": "contentType"}, "interview": {"external_interview_id": "id", "external_candidate_id": "candidateId", "external_job_id": "jobId", "scheduled_at": "scheduledAt", "interviewer_name": "interviewerName"}, "note": {"external_note_id": "id", "external_candidate_id": "candidateId", "content": "content", "author_name": "authorName"}}
}
