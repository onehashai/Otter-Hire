DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ats_db
IS_PRODUCTION=false
CORS_ORIGINS=http://app.localhost:3000,http://localhost:3000
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Frontend URL
FRONTEND_BASE_URL=http://app.localhost:3000

# Cookie domain (empty for localhost, .onehash.ai for production)
COOKIE_DOMAIN=

# Production example:
# FRONTEND_BASE_URL=https://app.onehash.ai
# COOKIE_DOMAIN=.onehash.ai
# CORS_ORIGINS=https://app.onehash.ai

# Staging example:
# FRONTEND_BASE_URL=https://app.staging.onehash.ai
# COOKIE_DOMAIN=.staging.onehash.ai
# CORS_ORIGINS=https://app.staging.onehash.ai

# Mailtrap (dev only - leave commented to print verification URLs to console)
# MAILTRAP_HOST=sandbox.smtp.mailtrap.io
# MAILTRAP_PORT=2525
# MAILTRAP_USERNAME=your_username
# MAILTRAP_PASSWORD=your_password
# MAILTRAP_FROM_EMAIL=noreply@onehash.ai

# ZeptoMail (prod only - required when IS_PRODUCTION=true)
# ZEPTOMAIL_API_KEY=your_api_key
# ZEPTOMAIL_FROM_EMAIL=noreply@onehash.ai
# ZEPTOMAIL_FROM_NAME=OneHash ATS
