# API URL
NEXT_PUBLIC_API_URL=http://api.localhost:8000

# Temporal UI (Admin > Background Jobs, Super Admin only)
NEXT_PUBLIC_TEMPORAL_UI_URL=http://localhost:8080

# Subdomain configuration
NEXT_PUBLIC_APP_SUBDOMAIN=app
NEXT_PUBLIC_JOBS_SUBDOMAIN=jobs
NEXT_PUBLIC_APP_ROOT_HOST=localhost:3000

# Production example:
# NEXT_PUBLIC_APP_SUBDOMAIN=app
# NEXT_PUBLIC_JOBS_SUBDOMAIN=jobs
# NEXT_PUBLIC_APP_ROOT_HOST=onehash.ai
# NEXT_PUBLIC_API_URL=https://api.onehash.ai

# Staging example:
# NEXT_PUBLIC_APP_SUBDOMAIN=app
# NEXT_PUBLIC_JOBS_SUBDOMAIN=jobs
# NEXT_PUBLIC_APP_ROOT_HOST=staging.onehash.ai
# NEXT_PUBLIC_API_URL=https://api.staging.onehash.ai

# Phase-0 feature flags for integrations refactor (keep false during baseline freeze)
# NEXT_PUBLIC_FEATURE_INTEGRATIONS_APP_STORE_UI=false
# NEXT_PUBLIC_FEATURE_LEGACY_ORG_INBOX_ROUTE_REDIRECT=false
