{
  "id": "generic_rest",
  "name": "Generic REST ATS",
  "enabled": true,
  "auth": {"type": "bearer", "header_name": "Authorization", "secret_ref": "GENERIC_ATS_TOKEN"},
  "base_url": "http://localhost:8992",
  "endpoints": {
    "jobs": {"path": "/jobs", "method": "GET", "response_root_key": "items"},
    "stages": {"path": "/stages", "method": "GET", "response_root_key": "items"},
    "candidates": {"path": "/candidates", "method": "GET", "response_root_key": "items"},
    "applications": {"path": "/applications", "method": "GET", "response_root_key": "items"},
    "resumes": {"path": "/resumes", "method": "GET", "response_root_key": "items"},
    "interviews": {"path": "/interviews", "method": "GET", "response_root_key": "items"},
    "notes": {"path": "/notes", "method": "GET", "response_root_key": "items"}
  },
  "pagination": {"style": "cursor", "cursor_request_param": "cursor", "cursor_response_path": "next_cursor", "page_size": 100},
  "rate_limits": {"requests_per_second": 2, "max_retries": 5, "backoff_seconds": 1},
  "mappings": {
    "job": {"external_job_id": "id", "title": "title", "description": "description"},
    "stage": {"external_stage_id": "id", "external_job_id": "job_id", "name": "name", "position": "position"},
    "candidate": {"external_candidate_id": "id", "first_name": "first_name", "last_name": "last_name", "email": "email", "phone": "phone", "skills": "skills", "resume_text": "resume_text"},
    "application": {"external_application_id": "id", "external_candidate_id": "candidate_id", "external_job_id": "job_id", "external_stage_id": "stage_id", "status": "status"},
    "resume": {"external_document_id": "id", "external_candidate_id": "candidate_id", "source_url": "url", "filename": "filename", "mime_type": "content_type", "content_base64": "content_base64"},
    "interview": {"external_interview_id": "id", "external_candidate_id": "candidate_id", "external_job_id": "job_id", "scheduled_at": "scheduled_at", "interviewer_name": "interviewer_name"},
    "note": {"external_note_id": "id", "external_candidate_id": "candidate_id", "content": "content", "author_name": "author_name"}
  }
}
