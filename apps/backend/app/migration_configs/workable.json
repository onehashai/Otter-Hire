{
  "id": "workable",
  "name": "Workable",
  "enabled": true,
  "auth": {"type": "bearer", "header_name": "Authorization"},
  "base_url": "http://localhost:8996",
  "endpoints": {"jobs": {"path": "/spi/v3/jobs", "method": "GET", "response_root_key": "jobs"}, "stages": {"path": "/spi/v3/stages", "method": "GET", "response_root_key": "stages"}, "candidates": {"path": "/spi/v3/candidates", "method": "GET", "response_root_key": "candidates", "pagination": {"style": "cursor", "cursor_response_path": "paging.next", "cursor_is_url": true, "page_size_param": "limit", "page_size": 100, "since_param_name": "updated_after"}}, "resumes": {"path": "/spi/v3/candidates/{external_candidate_id}", "method": "GET", "response_root_key": "candidate", "pagination": {"style": "none"}}},
  "pagination": {"style": "cursor", "cursor_response_path": "paging.next", "cursor_is_url": true, "page_size_param": "limit", "page_size": 100},
  "rate_limits": {"requests_per_second": 2, "max_retries": 5, "backoff_seconds": 1},
